---
import Layout from "../layouts/Layout.astro";
import { getTools } from "../lib/catalog";
import ToolsLive from "../components/live/ToolsLive.tsx";

const tools = await getTools();
---
<Layout
  title="The Armory"
  description="Darktier Studios' companion apps and utilities for board games and TTRPGs — consolidating under one roof. The Charlie Mike TOC is live."
  current="/tools"
>
  <div class="container">
    <section style="padding:84px 0 56px">
      <p class="kicker">Darktier Studios · software</p>
      <div style="display:flex;align-items:baseline;gap:21px;flex-wrap:wrap">
        <h1 style="font-size:clamp(44px,6vw,84px);line-height:1.04;letter-spacing:-0.02em;margin:0 0 0 -0.06em">The armory</h1>
        <span style="font-size:13px;letter-spacing:0.22em;text-transform:uppercase;color:var(--color-accent)">companions &amp; tools</span>
      </div>
      <p style="font-size:16px;line-height:28px;color:color-mix(in srgb, var(--color-text) 78%, transparent);max-width:58ch;margin:28px 0 0">
        Darktier's companions and utilities for board games and TTRPGs are consolidating here — one login, one shelf, no more scattered sites. Slots below fill in as each app docks.
      </p>
    </section>

    <ToolsLive initial={tools} client:load />


    <p style="font-size:13px;line-height:21px;color:color-mix(in srgb, var(--color-text) 55%, transparent);max-width:60ch;margin:14px 0 0">
      Which apps land next is still being decided — check back here for new arrivals.
    </p>
  </div>
</Layout>

<style is:global>
  .armory {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    padding-bottom: 28px;
  }
  .tool-card {
    border: 1px solid var(--color-neutral-700);
    border-radius: var(--radius-md);
    padding: 28px;
    background: color-mix(in srgb, var(--color-neutral-900) 45%, transparent);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .tool-card-live { border-color: var(--color-accent-700); }
  .tool-card:hover { border-color: var(--color-accent); box-shadow: var(--shadow-md); }
  .tool-kicker { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; margin: 0; }
  .tool-name { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 24px; line-height: 1.2; margin: 14px 0 0; }
  .tool-desc { font-size: 14px; line-height: 24px; color: color-mix(in srgb, var(--color-text) 72%, transparent); margin: 10px 0 0; }
  .tool-reserved {
    font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 45%, transparent); margin: 21px 0 0;
  }
</style>
