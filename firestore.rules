rules_version = '2';

// Darktier Studios catalog rules.
//
// - Public may READ any catalog doc that is not hidden (drafts stay private).
// - Only the OWNER (a single hardcoded Google UID) may WRITE, and may read
//   hidden docs.
//
// Replace OWNER_UID_PLACEHOLDER with the owner's real Google UID before deploy
// (Firebase Console → Authentication → Users). The rules-unit tests
// (scripts/rules.test.ts) swap in a test UID, so they pass regardless.
//
// Build-time SSG reads and the seed script use the Admin SDK, which bypasses
// these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null && request.auth.uid == '0z17c5sCiBZLdTKa3s08MDe7KFb2';
    }
    function isPublic() {
      return resource.data.hidden != true;
    }

    match /games/{slug} { allow read: if isPublic() || isOwner(); allow write: if isOwner(); }
    match /tools/{slug} { allow read: if isPublic() || isOwner(); allow write: if isOwner(); }
    match /news/{slug}  { allow read: if isPublic() || isOwner(); allow write: if isOwner(); }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
